# Web3Forms API key (https://web3forms.com)
# Usada por src/components/ContactModal.jsx (island) para el formulario.
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics token (panel CF -> Web Analytics -> tu sitio).
# Opcional: si está vacío, no se carga la analítica.
PUBLIC_CF_BEACON_TOKEN=

# Google Tag Manager container ID (formato GTM-XXXXXXX).
# Gestiona GA4 (G-XXXX) desde la UI de GTM. Opcional: vacío = sin GTM.
PUBLIC_GTM_ID=
