---
// Inter self-host (variable). Satoshi se carga desde Fontshare en el <head>.
import '@fontsource-variable/inter';
import '@/styles/global.css';

const {
  title = 'CFO Fraccional en Colombia | Asimétrica',
  description = 'CFO Fraccional y dirección financiera estratégica en Medellín y toda Colombia. Modelos financieros, flujo de caja y dashboards. Pide tu diagnóstico gratis.',
  jsonLd: jsonLdProp,
  preloadImage = '/plataformas.webp',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// Cloudflare Web Analytics (sin cookies). Se renderiza solo si hay token.
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Google Tag Manager. Define PUBLIC_GTM_ID (GTM-XXXXXXX) para activarlo.
// El contenedor GTM gestiona el tag de GA4 (Measurement ID G-XXXX) desde su UI.
const gtmId = import.meta.env.PUBLIC_GTM_ID;

// Microsoft Clarity (mapas de calor + grabaciones). Define PUBLIC_CLARITY_ID.
// Solo se carga tras consentir (mismo banner que GA) para respetar la privacidad.
const clarityId = import.meta.env.PUBLIC_CLARITY_ID;

// El banner de consentimiento aparece si hay cualquier herramienta de analítica.
const needsConsent = gtmId || clarityId;

// Grafo de marca: une asimetrica.co (Organization + servicio) con
// prisma.asimetrica.co (la plataforma) para que Google los lea como una entidad.
const ORG = 'https://asimetrica.co/#organization';
const phone = '+573001303558';
const linkedin = 'https://www.linkedin.com/company/asim%C3%A9trica';
const address = {
  '@type': 'PostalAddress',
  addressLocality: 'Medellín',
  addressRegion: 'Antioquia',
  addressCountry: 'CO',
};
const areaServed = [
  { '@type': 'City', name: 'Medellín' },
  { '@type': 'AdministrativeArea', name: 'Antioquia' },
  { '@type': 'City', name: 'Bogotá' },
  { '@type': 'Country', name: 'Colombia' },
];
const services = [
  'CFO Fraccional',
  'Dirección Financiera Estratégica',
  'Modelo Financiero de 3 Estados (FP&A)',
  'Flujo de Caja a 13 Semanas',
  'Valoración de Empresas (DCF)',
  'Preparación para Inversión y Venta (Investment Readiness)',
];

const jsonLd = jsonLdProp ?? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG,
      name: 'Asimétrica',
      url: 'https://asimetrica.co',
      logo: 'https://asimetrica.co/logo.png',
      image: 'https://asimetrica.co/og-image.png',
      description,
      slogan: 'Finanzas estratégicas',
      foundingLocation: { '@type': 'Place', name: 'Medellín, Colombia' },
      knowsAbout: [
        'CFO Fraccional',
        'Dirección Financiera Estratégica',
        'FP&A (Planeación y Análisis Financiero)',
        'Flujo de Caja',
        'Capital de Trabajo',
        'Valoración de Empresas',
        'Preparación para Inversión y Venta',
      ],
      telephone: phone,
      address,
      areaServed,
      knowsLanguage: 'es-CO',
      sameAs: [linkedin, 'https://prisma.asimetrica.co'],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: phone,
        contactType: 'sales',
        areaServed: 'CO',
        availableLanguage: 'Spanish',
      },
      owns: { '@id': 'https://prisma.asimetrica.co/#prisma' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://asimetrica.co/#service',
      name: 'Asimétrica — Dirección Financiera Estratégica',
      url: 'https://asimetrica.co',
      image: 'https://asimetrica.co/og-image.png',
      provider: { '@id': ORG },
      telephone: phone,
      address,
      areaServed,
      priceRange: '$$$',
      currenciesAccepted: 'COP',
      knowsLanguage: 'es-CO',
      sameAs: [linkedin],
      serviceType: services,
    },
    ...services.map((s, i) => ({
      '@type': 'Service',
      '@id': `https://asimetrica.co/#svc-${i}`,
      name: s,
      serviceType: s,
      provider: { '@id': ORG },
      areaServed: { '@type': 'Country', name: 'Colombia' },
    })),
    {
      '@type': 'WebSite',
      '@id': 'https://asimetrica.co/#website',
      url: 'https://asimetrica.co',
      name: 'Asimétrica',
      inLanguage: 'es-CO',
      publisher: { '@id': ORG },
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://prisma.asimetrica.co/#prisma',
      name: 'Prisma by Asimétrica',
      url: 'https://prisma.asimetrica.co',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'COP' },
      description:
        'Inteligencia financiera con acceso libre a los estados financieros y el análisis de más de 145.000 empresas colombianas.',
      publisher: { '@id': ORG },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <!-- Marca .js cuanto antes: el contenido animado (.fade-in) solo se oculta si hay JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    {/* Consent Mode v2: por defecto la analítica queda DENEGADA hasta que el
        usuario acepte (o hasta restaurar su decisión previa). Debe ir ANTES de GTM. */}
    {gtmId && (
      <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}var _m=document.cookie.match(/(?:^|; )asi-consent=(granted|denied)/);var _c=_m?_m[1]:null;gtag('consent','default',{'ad_storage':'denied','ad_user_data':'denied','ad_personalization':'denied','analytics_storage':_c==='granted'?'granted':'denied','wait_for_update':500});`} />
    )}

    <!-- Google Tag Manager. Activo solo si PUBLIC_GTM_ID está definido. -->
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');`} />
    )}

    {/* Microsoft Clarity. Se difiere hasta consentir: expone window.__loadClarity()
        y lo invoca solo si ya hay consentimiento guardado. */}
    {clarityId && (
      <script is:inline set:html={`(function(){window.__loadClarity=function(){if(window.__clarityLoaded)return;window.__clarityLoaded=true;(function(c,l,a,r,i){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};var t=l.createElement(r);t.async=1;t.src='https://www.clarity.ms/tag/'+i;var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,'clarity','script','${clarityId}');};var _m=document.cookie.match(/(?:^|; )asi-consent=(granted|denied)/);var c=_m?_m[1]:null;if(c==='granted')window.__loadClarity();})();`} />
    )}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- hreflang (es-CO único locale) -->
    <link rel="alternate" hreflang="es-co" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Preload del LCP para mejorar el Largest Contentful Paint -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Satoshi (Fontshare). Inter llega self-host vía @fontsource-variable/inter. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Cloudflare Web Analytics (sin cookies). Define PUBLIC_CF_BEACON_TOKEN
         (token del panel de Cloudflare → Web Analytics) para activarla. -->
    {cfBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeacon}"}`}></script>
    )}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <slot />

    {/* Consentimiento de cookies — sutil, abajo-izquierda. Solo si hay analítica. */}
    {needsConsent && (
      <>
        <div id="cookie-consent" class="cookie-consent" hidden>
          <p class="text-[0.8rem] leading-snug text-muted-foreground body-secondary">
            Usamos cookies de <span class="text-foreground">analítica</span> para entender cómo se usa el sitio y mejorarlo. Puedes aceptarlas o seguir sin ellas. <a href="/privacidad" class="text-foreground underline underline-offset-2 hover:text-primary">Más info</a>.
          </p>
          <div class="mt-3 flex items-center gap-2">
            <button data-consent="granted" type="button" class="rounded-md bg-primary px-3 py-1.5 text-[0.8rem] font-medium text-primary-foreground transition-colors hover:bg-primary/90">Aceptar</button>
            <button data-consent="denied" type="button" class="rounded-md px-3 py-1.5 text-[0.8rem] text-muted-foreground transition-colors hover:text-foreground">Rechazar</button>
          </div>
        </div>
        <script is:inline set:html={`(function(){var el=document.getElementById('cookie-consent');if(!el)return;var m=document.cookie.match(/(?:^|; )asi-consent=(granted|denied)/);var s=m?m[1]:null;if(!s){el.hidden=false;requestAnimationFrame(function(){el.classList.add('is-in');});}el.querySelectorAll('[data-consent]').forEach(function(b){b.addEventListener('click',function(){var v=b.getAttribute('data-consent');var dom=location.hostname.indexOf('asimetrica.co')>-1?';domain=.asimetrica.co':'';try{document.cookie='asi-consent='+v+';path=/;max-age=15552000'+dom+';SameSite=Lax';}catch(e){}if(typeof gtag==='function'){gtag('consent','update',{'analytics_storage':v==='granted'?'granted':'denied'});}if(v==='granted'&&typeof window.__loadClarity==='function'){window.__loadClarity();}el.classList.remove('is-in');setTimeout(function(){el.hidden=true;},250);});});})();`} />
      </>
    )}
  </body>
</html>
