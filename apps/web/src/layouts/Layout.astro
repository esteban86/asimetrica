---
// Inter self-host (variable). Satoshi se carga desde Fontshare en el <head>.
import '@fontsource-variable/inter';
import '@/styles/global.css';

const {
  title = 'Asimétrica — Finanzas Estratégicas | CFO Fraccional Colombia',
  description = 'Dirección Financiera Estratégica para empresas colombianas que quieren crecer con inteligencia. CFO Fraccional, modelos financieros y dashboards accionables.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

// Cloudflare Web Analytics (sin cookies). Se renderiza solo si hay token.
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// Grafo de marca: une asimetrica.co (Organization + servicio) con
// prisma.asimetrica.co (la plataforma) para que Google los lea como una entidad.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://asimetrica.co/#organization',
      name: 'Asimétrica',
      url: 'https://asimetrica.co',
      logo: 'https://asimetrica.co/logo.png',
      description,
      areaServed: 'CO',
      knowsLanguage: 'es',
      owns: { '@id': 'https://prisma.asimetrica.co/#prisma' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://asimetrica.co/#service',
      name: 'Asimétrica — Dirección Financiera Estratégica',
      url: 'https://asimetrica.co',
      provider: { '@id': 'https://asimetrica.co/#organization' },
      areaServed: 'CO',
      serviceType: ['CFO Fraccional', 'Dirección Financiera Estratégica', 'Modelos Financieros'],
    },
    {
      '@type': 'WebApplication',
      '@id': 'https://prisma.asimetrica.co/#prisma',
      name: 'Prisma by Asimétrica',
      url: 'https://prisma.asimetrica.co',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'COP' },
      description:
        'Inteligencia financiera con acceso libre a los estados financieros y el análisis de más de 145.000 empresas colombianas.',
      publisher: { '@id': 'https://asimetrica.co/#organization' },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <!-- Marca .js cuanto antes: el contenido animado (.fade-in) solo se oculta si hay JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <!-- Satoshi (Fontshare). Inter llega self-host vía @fontsource-variable/inter. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Cloudflare Web Analytics (sin cookies). Define PUBLIC_CF_BEACON_TOKEN
         (token del panel de Cloudflare → Web Analytics) para activarla. -->
    {cfBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeacon}"}`}></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <slot />
  </body>
</html>
