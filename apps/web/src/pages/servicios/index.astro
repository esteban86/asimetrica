---
import Layout from '@/layouts/Layout.astro';
import { seoPages } from '@/data/seoPages.js';

const base = 'https://asimetrica.co';
const items = seoPages.filter((p) => p.type === 'servicio');

const title = 'Servicios de Dirección Financiera | Asimétrica';
const description =
  'Servicios de CFO Fraccional, dirección financiera estratégica, FP&A, valoración y preparación para inversión para empresas en Colombia.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${base}/servicios#collection`,
      name: 'Servicios de Asimétrica',
      description,
      url: `${base}/servicios`,
      inLanguage: 'es-CO',
      isPartOf: { '@id': `${base}/#website` },
      about: { '@id': `${base}/#organization` },
    },
    {
      '@type': 'ItemList',
      itemListElement: items.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.breadcrumbLabel,
        url: `${base}/servicios/${p.slug}`,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: base },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${base}/servicios` },
      ],
    },
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd} preloadImage={null}>
  <main id="main" class="mx-auto max-w-5xl px-5 py-16 md:py-24">
    <nav aria-label="Migas" class="mb-6 text-sm text-muted-foreground body-secondary">
      <a href="/" class="link-underline hover:text-primary transition-colors">Inicio</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">Servicios</span>
    </nav>

    <h1 class="heading-secondary text-3xl md:text-4xl text-foreground">Servicios de dirección financiera</h1>
    <p class="mt-4 max-w-2xl text-muted-foreground body-text">
      La función financiera completa de un CFO senior —al ritmo y por una fracción del costo— para empresas
      colombianas que facturan entre $500 millones y $50.000 millones al año.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {items.map((p) => (
        <a
          href={`/servicios/${p.slug}`}
          class="group block rounded-xl border border-border/[0.12] bg-card/40 p-6 card-hover transition-colors hover:border-primary/40"
        >
          <h2 class="text-lg font-semibold text-foreground heading-tertiary group-hover:text-primary transition-colors">
            {p.breadcrumbLabel}
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground body-text">{p.heroSubhead}</p>
          <span class="mt-4 inline-block text-sm text-primary body-text">Ver servicio →</span>
        </a>
      ))}
    </div>

    <div class="mt-12">
      <a href="/recursos" class="link-underline text-sm text-muted-foreground hover:text-primary transition-colors body-text">
        ¿Buscas guías y recursos? →
      </a>
    </div>
  </main>
</Layout>
