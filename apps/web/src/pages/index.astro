        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-border/[0.06]">
          <p class="text-sm text-muted-foreground body-secondary">© 2026 Asimétrica · Finanzas Estratégicas · Colombia</p>
          <div class="flex items-center gap-2">
            <a href={linkedinLink} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn de Asimétrica" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:text-primary hover:bg-card transition-colors">
              <span set:html={iconLinkedin} />
