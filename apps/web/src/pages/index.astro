                <a href={linkedinLink} target="_blank" rel="noopener noreferrer" class="link-underline text-muted-foreground hover:text-primary transition-colors body-text">LinkedIn</a>
              </li>
              <li>
                <button data-open-contact class="link-underline text-muted-foreground hover:text-primary transition-colors body-text">Solicitar diagnóstico</button>
              </li>
