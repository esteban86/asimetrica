            <img src="/logo.png" alt="Asimétrica" width="120" height="32" class="h-7 w-auto mb-4" />
            <p class="text-sm text-muted-foreground leading-relaxed body-secondary">Dirección financiera estratégica · CFO Fraccional.</p>
            <p class="text-sm text-muted-foreground mt-2 body-secondary">Medellín, Colombia</p>
          </div>

          <div>
            <p class="text-xs uppercase tracking-wider text-foreground/70 mb-3 body-secondary font-semibold">Navega</p>
            <ul class="space-y-2.5 text-sm">
              {['solucion', 'proceso', 'herramientas', 'planes'].map((s) => (
                <li>
