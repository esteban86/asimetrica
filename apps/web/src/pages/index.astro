    <!-- Footer -->
    <footer class="border-t border-border/[0.08] pt-16 pb-28 md:pb-12 bg-card/30">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-12">
