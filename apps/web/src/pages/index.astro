          <div>
            <p class="text-xs uppercase tracking-wider text-foreground/70 mb-3 body-secondary font-semibold">Plataforma</p>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href="https://prisma.asimetrica.co" target="_blank" rel="noopener noreferrer" class="link-underline text-muted-foreground hover:text-primary transition-colors body-text">Prisma ↗</a>
