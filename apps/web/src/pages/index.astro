---
import Layout from '@/layouts/Layout.astro';
import ContactModal from '@/components/ContactModal.jsx';

const navSections = ['problema', 'solucion', 'proceso', 'herramientas', 'prisma', 'planes', 'contacto'];

const heroBullets = ['Dashboards en tiempo real', 'Desarrollados in-house', 'Incluidos en todos los planes'];

const problemas = [
  { num: '01', title: 'Contabilidad de espejo retrovisor.', desc: 'Solo miras el pasado, nunca el camino que viene.' },
  { num: '02', title: 'Caja estrecha a pesar de las ventas.', desc: 'Vendes pero el dinero nunca aparece cuando lo necesitas.' },
  { num: '03', title: 'Decisiones a ciegas.', desc: 'Sin datos confiables, cada decisión grande es una apuesta.' },
];

const successPoints = [
  'Entras a la junta sabiendo tu caja de las próximas 13 semanas.',
  'Sabes qué línea de negocio crea valor — y cuál lo destruye.',
  'Cuando el banco o un inversionista pide cifras, las tienes en un clic.',
];

const pilares = [
  { num: '01', title: 'CLARIDAD', color: 'primary', desc: 'Sabes exactamente dónde estás parado: cuánto generas, cuánto gastas, cuánto queda y por qué.' },
  { num: '02', title: 'DIRECCIÓN', color: 'primary', desc: 'Tienes un modelo que proyecta escenarios, anticipa crisis y guía cada decisión con datos confiables.' },
  { num: '03', title: 'CRECIMIENTO', color: 'primary', desc: 'Liberas caja, optimizas capital de trabajo y estructuras la empresa para escalar o atraer inversión.' },
];

// Herramientas redactadas como BENEFICIO (qué gana el cliente), no como feature.
const tools = [
  { title: 'Modelo de 3 Estados', category: 'Tu base financiera', desc: 'Ves de dónde viene y a dónde va cada peso — histórico y proyectado, todo conectado.' },
  { title: 'Flujo de Caja 13 Semanas', category: 'Duermes tranquilo', desc: 'Nunca más te agarra desprevenido un viernes de nómina: ves la crisis antes de que llegue.' },
  { title: 'Dashboard de KPIs', category: 'Tus números, a la vista', desc: 'EBITDA, margen, cartera y deuda en una pantalla — sin esperar al cierre contable.' },
  { title: 'Capital de Trabajo', category: 'Liberas caja', desc: 'Recuperas el dinero atrapado en cartera, inventario y proveedores.' },
  { title: 'Presupuesto y Forecast', category: 'Sabes a dónde vas', desc: 'Plan anual + ajuste trimestral: detectas la desviación antes, no en el balance de fin de año.' },
  { title: 'Árbol de Rentabilidad', category: 'Qué te da plata', desc: 'Descubres qué cliente, producto o canal te hace ganar — y cuál te la está quitando.' },
  { title: 'Análisis de Deuda y Capital', category: 'Pagas menos', desc: 'Revisamos pasivos, tasas y plazos para que pagues menos intereses y negocies mejor.' },
  { title: 'Investment Readiness Pack', category: 'Listo para crecer', desc: 'Memo de inversión, valoración y data room: listo para levantar capital o vender.' },
];

const prismaFeatures = [
  'Estados financieros NIIF: P&G, balance y flujos de caja',
  'Ratios de liquidez, rentabilidad y apalancamiento',
  'Scoring de riesgo: Altman Z, Piotroski y Beneish',
  'Benchmarking sectorial por código CIIU',
];
const prismaShots = [
  { src: '/prisma-macro.webp', title: 'Vista Macro' },
  { src: '/prisma-empresa.webp', title: 'Ficha de empresa' },
  { src: '/prisma-screener.webp', title: 'Screener' },
  { src: '/prisma-scoring.webp', title: 'Scoring y DuPont' },
];

const steps = [
  { num: '00', title: 'Diagnóstico Flash', time: '48h · Sin costo', desc: 'Revisamos tus estados financieros e identificamos 3–5 ineficiencias concretas con su impacto en COP.' },
  { num: '01', title: 'Inmersión y Diagnóstico', time: 'Semanas 1–4', desc: 'Conocemos el negocio a fondo: ingresos, costos, caja, deuda. Construimos el modelo base y la hoja de ruta de 90 días.' },
  { num: '02', title: 'Quick Wins', time: 'Meses 2–3', desc: 'Activamos las herramientas de mayor impacto. Generamos los primeros resultados cuantificables.' },
  { num: '03', title: 'Dirección Continua', time: 'Mes 4 en adelante', desc: 'Cadencia mensual: modelo actualizado, comité financiero, informe ejecutivo y soporte constante.' },
];

const plans = [
  { name: 'ESENCIAL', price: '$1.900.000', period: '/mes', tagline: 'Asesoría + Plataforma FP&A', outcome: 'Pon la casa en orden y deja de decidir a ciegas.', forWho: 'Startups y empresas dando el siguiente paso', features: ['Modelo de 3 Estados', 'Dashboard de KPIs', 'Árbol de Rentabilidad', 'Análisis de Deuda', 'Flujo de Caja 13 semanas', 'Comité Financiero · 2h/mes', 'Respuesta en 2 días'] },
  { name: 'CRECIMIENTO', price: '$4.900.000', period: '/mes', tagline: 'Asesoría + Plataforma FP&A', badge: 'Más Elegido', highlight: true, outcome: 'Escala sin que el crecimiento te ahogue la caja.', forWho: 'Empresas maduras en plena expansión', features: ['Todo lo de Esencial, más:', 'Capital de Trabajo', 'Flujo de caja semanal', 'Presupuesto + 4h/mes', 'Sesión pre-junta', 'Valoración básica', 'Respuesta en 1 día'] },
  { name: 'ESTRATÉGICO', price: '$7.900.000', period: '/mes', tagline: 'Asesoría + Plataforma FP&A', outcome: 'Dirige como una compañía lista para invertir o vender.', forWho: 'Compañías que exigen alto nivel', features: ['Todo lo de Crecimiento, más:', 'Investment Readiness Pack', 'Valoración DCF', 'Data Room', 'Deck de junta directiva', 'Analítica avanzada', 'Respuesta el mismo día'] },
];

const btnPrimary = 'group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium transition-all duration-200 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring bg-primary text-primary-foreground hover:bg-primary/90 cursor-pointer';

const iconArrow = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
const iconExternal = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/></svg>';
const iconCheck = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>';
const iconMenu = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>';
const iconShield = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>';
const iconWhatsapp ='<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>';
const iconLinkedin = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>';

const waLink = 'https://wa.me/573001303558?text=' + encodeURIComponent('Hola, vengo de la web y quiero más información sobre Asimétrica.');
const linkedinLink = 'https://www.linkedin.com/company/asim%C3%A9trica';

// Asterisco-marca tricolor (eco del logo): 3 ejes, 3 colores del sistema.
const iconAster = '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="2.5" x2="12" y2="21.5" stroke="hsl(var(--primary))"/><line x1="3.8" y1="7.25" x2="20.2" y2="16.75" stroke="hsl(var(--secondary))"/><line x1="20.2" y1="7.25" x2="3.8" y2="16.75" stroke="hsl(var(--accent))"/></svg>';
---

<Layout>
  <div class="grain min-h-screen bg-background text-foreground">
    <!-- Header -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-lg border-b border-border/[0.08]">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="nav-row flex items-center justify-between h-16">
          <button data-scroll="hero" class="flex items-center gap-3 transition-opacity hover:opacity-90 focus:outline-none" aria-label="Volver al inicio">
            <img src="/logo.png" alt="Asimétrica" width="120" height="32" class="h-8 w-auto" />
            <span class="text-sm text-muted-foreground hidden sm:inline body-secondary border-l border-border/[0.2] pl-3">Finanzas estratégicas</span>
          </button>

          <div class="hidden md:flex items-center gap-6 text-sm body-text">
            {navSections.map((section) => (
              <button data-scroll={section} data-nav={section} class="capitalize transition-all duration-200 hover:text-primary text-muted-foreground">
                {section === 'solucion' ? 'Solución' : section}
              </button>
            ))}
          </div>

          <div class="flex items-center gap-2">
            <button data-open-contact class={`${btnPrimary} h-11 md:h-9 px-4 text-sm body-text`}>
              Contáctanos
            </button>
            <button id="menu-toggle" class="md:hidden inline-flex items-center justify-center h-11 w-11 rounded-md text-muted-foreground hover:text-primary hover:bg-card transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
              <span set:html={iconMenu} />
            </button>
          </div>
        </div>
      </nav>

      <!-- Menú móvil -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-border/[0.08] bg-background/95 backdrop-blur-lg">
        <nav class="flex flex-col px-4 py-3 gap-1 max-w-7xl mx-auto">
          {navSections.map((section) => (
            <button data-scroll={section} class="capitalize text-left py-2.5 px-2 rounded-md text-muted-foreground hover:text-primary hover:bg-card transition-colors body-text">
              {section === 'solucion' ? 'Solución' : section}
            </button>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section id="hero" class="axis-host relative md:min-h-screen flex items-center overflow-hidden pt-24 pb-12 md:pb-16">
        <div class="aurora-glow turquesa"></div>
        <div class="aurora-glow purpura"></div>
        <div class="hero-grid"></div>
        <div class="aster-watermark brand-aster spin [&>svg]:w-full [&>svg]:h-auto" style="top:-6rem; right:-7rem;" set:html={iconAster}></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
            <div class="fade-in text-center lg:text-left lg:col-span-5">
              <p class="eyebrow justify-center lg:justify-start before:hidden">
                <span class="brand-aster spin inline-block w-4 h-4 [&>svg]:w-full [&>svg]:h-full" set:html={iconAster}></span>
                CFO Fraccional · Colombia
              </p>
              <h1 class="hero-reveal text-4xl md:text-6xl lg:text-7xl heading-primary mb-6 leading-[1.05]">
                <span class="rl" style="--rl:0">Deja de dirigir</span><br />
                <span class="rl" style="--rl:1">tu empresa por el</span><br />
                <span class="rl" style="--rl:2"><span class="gradient-text-primary focus-word">retrovisor</span>.</span>
              </h1>
              <p class="text-lg md:text-xl text-muted-foreground mb-8 leading-relaxed body-text max-w-xl mx-auto lg:mx-0">
                Libera caja, anticipa las crisis y respalda cada decisión con datos — con un equipo de dirección financiera estratégica, sin el costo de un CFO en nómina.
              </p>
              <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center">
                <button data-open-contact class={`${btnPrimary} h-12 px-8 text-base body-text`}>
                  Solicitar Diagnóstico Gratis
                  <span class="transition-transform duration-200 group-hover:translate-x-1" set:html={iconArrow} />
                </button>
                <button data-scroll="planes" class="link-underline inline-flex items-center justify-center h-11 px-2 text-base text-foreground hover:text-primary transition-all duration-200 body-text">
                  Ver los planes
                </button>
              </div>
              <div class="flex flex-wrap justify-center lg:justify-start gap-x-5 gap-y-2 mt-8">
                {heroBullets.map((b) => (
                  <span class="inline-flex items-center gap-2 text-xs text-muted-foreground body-secondary">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>{b}
                  </span>
                ))}
              </div>
            </div>

            <div class="fade-in relative lg:col-span-7 lg:-mr-12 xl:-mr-20" id="hero-visual">
              <div class="data-light hidden lg:block" style="inset:-2rem; border-radius:9999px;"></div>

              <div class="dash-tilt relative z-10">
                <div class="product-shot overflow-hidden">
                  <img src="/plataformas.webp" alt="Dashboard de Asimétrica — Flujo de Caja 13 semanas" width="1400" height="788" fetchpriority="high" decoding="async" class="w-full h-auto block" />
                </div>
              </div>

              <!-- Único chip de vidrio: el dato como instrumento -->
              <div class="float-chip glass hidden lg:block absolute -left-6 top-10 rounded-xl p-3 w-44 z-20">
                <p class="text-[10px] uppercase tracking-[0.14em] text-muted-foreground body-secondary mb-1.5">Flujo de caja · <span class="tnum">13</span> sem</p>
                <svg viewBox="0 0 120 40" class="w-full h-9" fill="none" aria-hidden="true">
                  <polyline class="spark-path" points="0,34 17,29 34,31 51,21 68,23 85,13 102,9 120,4" stroke="hsl(var(--primary))" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Prueba social — OCULTA hasta tener material real (testimonios y/o logos de clientes).
          Para reactivar: quita las llaves de comentario que envuelven este <section>.
      <section id="clientes" class="py-14 border-y border-border/[0.08] bg-card/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 fade-in">
          <p class="text-center text-xs uppercase tracking-wider text-muted-foreground mb-8 body-secondary">
            Empresas que ya dirigen con datos
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 max-w-4xl mx-auto opacity-80">
            {[1, 2, 3, 4].map(() => (
              <div class="h-12 rounded-md border border-dashed border-border/[0.18] flex items-center justify-center text-[11px] text-muted-foreground body-secondary">
                [ Logo cliente ]
              </div>
            ))}
          </div>
          <figure class="max-w-3xl mx-auto mt-12 text-center">
            <blockquote class="text-xl md:text-2xl heading-tertiary text-foreground leading-snug">
              "En 90 días pasamos de no saber nuestra caja a proyectarla a 13 semanas. Liberamos capital de trabajo."
            </blockquote>
            <figcaption class="mt-4 text-sm text-muted-foreground body-secondary">
              Nombre Apellido, CEO de Empresa (ejemplo)
            </figcaption>
          </figure>
        </div>
      </section>
      */}

      <!-- El Problema -->
      <section id="problema" class="axis-host py-12 md:py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="fade-in mb-10 max-w-3xl">
            <p class="eyebrow">El reto</p>
            <h2 class="reveal-lines text-3xl md:text-4xl heading-section mb-5">
              <span class="rl">El <span class="text-secondary">Problema</span></span>
            </h2>
            <p class="text-xl md:text-2xl text-foreground heading-tertiary leading-snug">
              Trabajas más que nunca, vendes más que nunca… y aun así no sabes si tu empresa vale más hoy que hace un año.
            </p>
          </div>

          <div class="space-y-8 max-w-4xl">
            {problemas.map((item, index) => (
              <div class="fade-in flex gap-6 items-start" style={`transition-delay:${index * 100}ms`}>
                <span class="folio-outline is-pain text-7xl md:text-8xl" aria-hidden="true">{item.num}</span>
                <div>
                  <h3 class="text-xl heading-tertiary mb-2">{item.title}</h3>
                  <p class="text-muted-foreground description">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <div class="section-divider"></div>

      <!-- Qué es Asimétrica + Visión de éxito -->
      <section id="solucion" class="axis-host py-12 md:py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="fade-in mb-8">
            <p class="eyebrow">Quiénes somos</p>
            <h2 class="reveal-lines text-3xl md:text-4xl heading-section mb-6">
              <span class="rl">¿Qué es <span class="gradient-text-primary">Asimétrica</span>?</span>
            </h2>
          </div>

          <div class="fade-in max-w-4xl mb-16">
            <p class="text-lg text-muted-foreground leading-relaxed mb-6 body-text">
              Somos tu equipo de <strong class="text-foreground">dirección financiera estratégica</strong> — la experiencia y las herramientas de un gerente financiero, sin el costo fijo de tenerlo en nómina. Eso es un <strong class="text-foreground">CFO Fraccional</strong>: la función financiera completa, al ritmo de tu empresa.
            </p>
            <p class="text-lg text-muted-foreground leading-relaxed body-text">
              Trabajamos con empresas que facturan entre <strong class="text-foreground tnum">$500M y $50.000M COP</strong> al año y que están listas para dejar de adivinar y empezar a dirigir.
            </p>
          </div>

          <div class="fade-in">
            <h3 class="text-2xl heading-tertiary mb-8">Así se ve dirigir con Asimétrica</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {successPoints.map((point, index) => (
                <div class="card-surface p-6 border-l-2 border-l-primary" style={`transition-delay:${index * 80}ms`}>
                  <p class="text-base text-foreground leading-relaxed body-text">{point}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <div class="section-divider"></div>

      <!-- Proceso (el plan) -->
      <section id="proceso" class="axis-host py-12 md:py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="fade-in mb-12 max-w-3xl">
            <p class="eyebrow">El proceso</p>
            <h2 class="reveal-lines text-3xl md:text-4xl heading-section mb-4">
              <span class="rl">Cómo <span class="text-primary">Trabajamos</span></span>
            </h2>
            <p class="text-lg text-muted-foreground body-text">
              Un camino claro, con un primer paso sin riesgo. Empezamos con un diagnóstico gratis.
            </p>
          </div>

          <div class="space-y-12 max-w-4xl">
            {steps.map((step, index) => (
              <div class="fade-in flex gap-6 items-start" style={`transition-delay:${index * 100}ms`}>
                <div class="flex flex-col items-center">
                  <div class="proc-circle w-16 h-16 rounded-xl bg-primary/10 border-2 border-primary flex items-center justify-center flex-shrink-0">
                    <span class="text-2xl font-bold text-primary heading-secondary tnum">{step.num}</span>
                  </div>
                  {index < steps.length - 1 && <div class="proc-line w-0.5 h-12 bg-gradient-to-b from-primary to-transparent mt-4"></div>}
                </div>
                <div class="flex-1 pt-2">
                  <div class="flex items-baseline gap-3 mb-2 flex-wrap">
