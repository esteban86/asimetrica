            <a href={waLink} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp de Asimétrica" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:text-primary hover:bg-card transition-colors">
