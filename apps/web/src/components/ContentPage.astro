---
import ContactModal from '@/components/ContactModal.jsx';
import Visual from '@/components/Visual.astro';
import WorkingCapitalExplorer from '@/components/WorkingCapitalExplorer.jsx';
import DcfExplorer from '@/components/DcfExplorer.jsx';
import CashFlow13Explorer from '@/components/CashFlow13Explorer.jsx';
import IncomeStatementWaterfall from '@/components/IncomeStatementWaterfall.jsx';
import BalanceSheetComposition from '@/components/BalanceSheetComposition.jsx';
import CashFlowBridge from '@/components/CashFlowBridge.jsx';
import DuPontTree from '@/components/DuPontTree.jsx';
import VarianceBridge from '@/components/VarianceBridge.jsx';

/**
 * @typedef {{ heading: string, paragraphs: string[], bullets?: string[] }} Section
 * @typedef {{ q: string, a: string }} FaqItem
 * @typedef {{ label: string, href: string }} LinkItem
 * @typedef {{ type: string, slug: string, primaryKeyword: string, metaTitle: string, metaDescription: string, breadcrumbLabel: string, h1: string, heroSubhead: string, sections: Section[], faq: FaqItem[], internalLinks: LinkItem[], cta: { heading: string, text: string }, keyStats?: {value:string,label:string}[], visuals?: any[], glossary?: {term:string,def:string}[] }} PageData
 */

/** @type {PageData} */
const page = Astro.props.page;
/** @type {{ label: string, href: string | null }[]} */
const crumbs = Astro.props.crumbs;

const waLink = 'https://wa.me/573001303558?text=' + encodeURIComponent('Hola, vengo de la web y quiero más información sobre Asimétrica.');
const btnPrimary = 'group inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md font-medium transition-all duration-200 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring bg-primary text-primary-foreground hover:bg-primary/90 cursor-pointer';
const iconArrow = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
const iconWhatsapp = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.247-.694.247-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"/></svg>';
const iconCheck = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-primary flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>';
---

<div class="grain min-h-screen bg-background text-foreground">
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-lg border-b border-border/[0.08]">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-90" aria-label="Asimétrica · Inicio">
          <img src="/logo.png" alt="Asimétrica" width="120" height="32" class="h-8 w-auto" />
          <span class="text-sm text-muted-foreground hidden sm:inline body-secondary border-l border-border/[0.2] pl-3">Finanzas estratégicas</span>
        </a>
        <div class="flex items-center gap-5 text-sm body-text">
          <a href="/#planes" class="hidden sm:inline text-muted-foreground hover:text-primary transition-colors">Planes</a>
          <a href="/#faq" class="hidden sm:inline text-muted-foreground hover:text-primary transition-colors">FAQ</a>
          <button data-open-contact class={`${btnPrimary} h-11 md:h-9 px-4 text-sm body-text`}>Contáctanos</button>
        </div>
      </div>
    </nav>
  </header>

  <main id="main" class="pt-24">
    <!-- Hero + breadcrumb -->
    <section class="relative overflow-hidden py-10 md:py-16">
      <div class="aurora-glow turquesa"></div>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground body-secondary">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span class="text-muted-foreground/50">/</span>}
                {c.href ? <a href={c.href} class="hover:text-primary transition-colors">{c.label}</a> : <span class="text-foreground">{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">{page.type === 'servicio' ? 'Servicio' : 'Guía'}</p>
        <h1 class="text-3xl md:text-5xl heading-primary mb-5 leading-[1.1]">{page.h1}</h1>
        <p class="text-lg md:text-xl text-muted-foreground leading-relaxed body-text">{page.heroSubhead}</p>
        <div class="mt-8">
          <button data-open-contact class={`${btnPrimary} h-12 px-8 text-base body-text`}>
            Solicitar Diagnóstico Gratis
            <span class="transition-transform duration-200 group-hover:translate-x-1" set:html={iconArrow} />
          </button>
        </div>
      </div>
    </section>

    <!-- Tira de cifras clave -->
    {page.keyStats && page.keyStats.length > 0 && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {page.keyStats.map((k) => (
            <div class="card-surface p-4 text-center">
              <div class="text-2xl md:text-3xl heading-secondary text-primary tnum leading-none">{k.value}</div>
              <div class="text-xs text-muted-foreground body-secondary mt-1.5 leading-snug">{k.label}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    {page.slug === 'optimizar-capital-de-trabajo' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <WorkingCapitalExplorer client:visible />
      </div>
    )}
    {page.slug === 'valoracion-de-empresas' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <DcfExplorer client:visible />
      </div>
    )}
    {page.slug === 'flujo-de-caja-13-semanas' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <CashFlow13Explorer client:visible />
      </div>
    )}
    {page.slug === 'modelo-financiero-tres-estados' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 space-y-6">
        <IncomeStatementWaterfall client:visible />
        <BalanceSheetComposition client:visible />
        <CashFlowBridge client:visible />
      </div>
    )}
    {page.slug === 'arbol-de-rentabilidad' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <DuPontTree client:visible />
      </div>
    )}
    {page.slug === 'fpa-presupuesto-forecast' && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
        <VarianceBridge client:visible />
      </div>
    )}

    <!-- Índice + Cuerpo -->
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <nav class="card-surface p-5 mt-10" aria-label="Contenido de la página">
        <p class="text-xs uppercase tracking-[0.14em] font-semibold text-primary mb-3 body-secondary">En esta página</p>
        <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
          {page.sections.map((s, i) => (
            <li>
              <a href={`#s-${i}`} class="link-underline text-muted-foreground hover:text-primary transition-colors body-text">{s.heading}</a>
            </li>
          ))}
        </ol>
      </nav>

      {page.sections.map((s, i) => (
        <>
          <section id={`s-${i}`} class="mt-12 scroll-mt-24">
            <h2 class="text-2xl md:text-3xl heading-section mb-4">{s.heading}</h2>
            {s.paragraphs.map((p) => (
              <p class="text-base md:text-lg text-muted-foreground leading-relaxed body-text mb-4">{p}</p>
            ))}
            {s.bullets && (
              <ul class="space-y-3 mt-4">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-3 body-text">
                    <span set:html={iconCheck} />
                    <span class="text-muted-foreground leading-relaxed">{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
          {(page.visuals ?? []).filter((vv) => vv.afterSection === i).map((vv) => <Visual v={vv} />)}
        </>
      ))}
    </article>

    <div class="section-divider"></div>

    <!-- FAQ -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 class="text-2xl md:text-3xl heading-section mb-8">Sobre {page.breadcrumbLabel.toLowerCase()}</h2>
      <div class="divide-y divide-white/[0.08]">
        {page.faq.map((f) => (
          <details class="group/f py-4">
            <summary class="cursor-pointer list-none flex items-start justify-between gap-4">
              <span class="text-base md:text-lg heading-tertiary text-foreground">{f.q}</span>
              <span class="mt-0.5 flex-shrink-0 text-2xl leading-none text-primary transition-transform duration-200 group-open/f:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-muted-foreground leading-relaxed description">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Enlaces internos -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <p class="eyebrow">Sigue explorando</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
        {page.internalLinks.map((l) => (
          <a href={l.href} class="card-surface card-hover p-4 flex items-center justify-between gap-3 group">
            <span class="text-sm text-foreground body-text">{l.label}</span>
            <span class="text-primary transition-transform duration-200 group-hover:translate-x-1" set:html={iconArrow} />
          </a>
        ))}
      </div>
    </section>

    <div class="gradient-separator"></div>

    <!-- CTA -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
      <h2 class="text-3xl md:text-4xl heading-section mb-5">{page.cta.heading}</h2>
      <p class="text-lg text-muted-foreground mb-8 leading-relaxed body-text">{page.cta.text}</p>
      <button data-open-contact class={`${btnPrimary} h-14 px-12 text-lg body-text mx-auto`}>
        Solicitar Diagnóstico Gratis
        <span class="transition-transform duration-200 group-hover:translate-x-1" set:html={iconArrow} />
      </button>
      <p class="text-sm text-muted-foreground mt-6 body-secondary">
        Te respondemos en menos de 48 horas, sin compromiso — o <a href={waLink} target="_blank" rel="noopener noreferrer" class="link-underline text-primary">escríbenos por WhatsApp</a>.
      </p>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-border/[0.08] pt-12 pb-28 md:pb-10 bg-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.png" alt="Asimétrica" width="120" height="32" class="h-7 w-auto" />
        <span class="text-sm text-muted-foreground body-secondary">Medellín, Colombia</span>
      </a>
      <p class="text-sm text-muted-foreground body-secondary">© 2026 Asimétrica · Finanzas Estratégicas</p>
    </div>
  </footer>

  <!-- WhatsApp flotante -->
  <a href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp" class="fixed bottom-6 right-4 md:right-6 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-card/90 backdrop-blur border border-border/[0.12] shadow-lg hover:scale-105 active:scale-95 transition-transform">
    <span style="color:#25D366" set:html={iconWhatsapp} />
  </a>

  <ContactModal client:idle />
</div>

<script>
  document.querySelectorAll('[data-open-contact]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(new Event('open-contact-modal'));
    });
  });
</script>

<script define:vars={{ glossary: page.glossary ?? [] }}>
  /* global glossary */
  // Sidenotes estilo distill: realza jerga en el cuerpo con una definición
  // en hover/focus/tap. Opera sobre el texto ya escapado (sin innerHTML
  // proveniente de datos), así que es seguro y respeta los '&' del contenido.
  if (Array.isArray(glossary) && glossary.length) {
    const article = document.querySelector('article');
    // términos más largos primero, para que "rolling forecast" gane sobre "forecast"
    const terms = [...glossary].sort((a, b) => b.term.length - a.term.length);
    const paras = article ? article.querySelectorAll('p.body-text') : [];

    const wrapFirst = ({ term, def }) => {
      const needle = term.toLowerCase();
      for (const p of paras) {
        // recorre solo nodos de texto directos (no toca spans ya creados)
        for (const node of [...p.childNodes]) {
          if (node.nodeType !== Node.TEXT_NODE) continue;
          const text = node.nodeValue;
          const idx = text.toLowerCase().indexOf(needle);
          if (idx === -1) continue;

          const before = text.slice(0, idx);
          const match = text.slice(idx, idx + term.length);
          const after = text.slice(idx + term.length);

          const span = document.createElement('span');
          span.className = 'dfn';
          span.setAttribute('tabindex', '0');
          span.appendChild(document.createTextNode(match));
          const note = document.createElement('span');
          note.className = 'dfn-note';
          note.setAttribute('role', 'tooltip');
          note.textContent = def; // textContent => sin inyección de HTML
          span.appendChild(note);

          const frag = document.createDocumentFragment();
          if (before) frag.appendChild(document.createTextNode(before));
          frag.appendChild(span);
          if (after) frag.appendChild(document.createTextNode(after));
          p.replaceChild(frag, node);
          return; // solo la primera aparición de cada término
        }
      }
    };

    terms.forEach(wrapFirst);
  }
</script>
